# 应用依赖
DATABASE__URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai
REDIS__URL=redis://localhost:6379/0

# MinIO 仅保存 RAG 原文件；本地默认账号只用于开发，生产环境必须替换。
OBJECT_STORAGE__ENDPOINT=localhost:9000
OBJECT_STORAGE__ACCESS_KEY=minioadmin
OBJECT_STORAGE__SECRET_KEY=minioadmin
OBJECT_STORAGE__SECURE=false
OBJECT_STORAGE__BUCKET_NAME=enterprise-ai-documents
OBJECT_STORAGE__MAX_FILE_SIZE_BYTES=20971520

# Embedding 默认使用稳定哈希 Mock，不消耗真实模型额度。
# 切换 openai_compatible 后必须在本机 .env 填写 API Key；数据库第一版固定 1024 维。
EMBEDDING__PROVIDER=mock
EMBEDDING__API_KEY=
EMBEDDING__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING__MODEL=text-embedding-v4
EMBEDDING__MOCK_MODEL=mock-hash-1024
EMBEDDING__DIMENSION=1024
EMBEDDING__BATCH_SIZE=10
EMBEDDING__TIMEOUT_SECONDS=30
EMBEDDING__MAX_RETRIES=2

# RAG 文档按 Token 分块，不跨 PDF 页码或 Markdown 标题来源边界。
RAG__CHUNK_SIZE_TOKENS=600
RAG__CHUNK_OVERLAP_TOKENS=80
# 检索先多召回候选，再由后端阈值过滤；初始阈值需要在评测阶段继续校准。
RAG__MOCK_SIMILARITY_THRESHOLD=0.2
RAG__OPENAI_COMPATIBLE_SIMILARITY_THRESHOLD=0.45
RAG__SEARCH_CANDIDATE_MULTIPLIER=4
# 默认阈值模式完全本地；切换 llm 后搜索 API 与会话 RAG 都使用 DeepSeek 证据选择。
RAG__EVIDENCE_SELECTOR=threshold
RAG__LLM_EVIDENCE_SELECTOR_MODEL=deepseek-v4-flash
RAG__LLM_EVIDENCE_SELECTOR_TIMEOUT_SECONDS=30
RAG__LLM_EVIDENCE_SELECTOR_THINKING_ENABLED=false
RAG__LLM_EVIDENCE_SELECTOR_MAX_OUTPUT_RETRIES=1

# Celery 使用独立 Redis DB 传递任务；任务业务状态仍保存在 PostgreSQL。
WORKER__BROKER_URL=redis://localhost:6379/1
WORKER__DEFAULT_QUEUE=conversation-summary
WORKER__TASK_SOFT_TIME_LIMIT_SECONDS=270
WORKER__TASK_TIME_LIMIT_SECONDS=300
WORKER__SUMMARY_RETRY_BASE_DELAY_SECONDS=30
WORKER__SUMMARY_RETRY_MAX_DELAY_SECONDS=300
WORKER__SUMMARY_RECOVERY_INTERVAL_SECONDS=60
WORKER__SUMMARY_RUNNING_TIMEOUT_SECONDS=600
WORKER__SUMMARY_DISPATCH_LEASE_SECONDS=120
WORKER__SUMMARY_RECOVERY_BATCH_SIZE=100
WORKER__DOCUMENT_INGESTION_QUEUE=document-ingestion
WORKER__DOCUMENT_RETRY_BASE_DELAY_SECONDS=30
WORKER__DOCUMENT_RETRY_MAX_DELAY_SECONDS=300
WORKER__DOCUMENT_RECOVERY_INTERVAL_SECONDS=60
WORKER__DOCUMENT_RUNNING_TIMEOUT_SECONDS=900
WORKER__DOCUMENT_DISPATCH_LEASE_SECONDS=120
WORKER__DOCUMENT_RECOVERY_BATCH_SIZE=100

# 长会话记忆参数；达到触发阈值后创建持久化摘要任务。
CONVERSATION_MEMORY__SUMMARY_TRIGGER_TOKENS=3000
CONVERSATION_MEMORY__RECENT_HISTORY_BUDGET_TOKENS=2000
CONVERSATION_MEMORY__SUMMARY_BATCH_TOKENS=4000

# 本地默认使用 Mock Provider；真实密钥只写入未提交的 .env。
DEFAULT_PROVIDER=mock
DEEPSEEK__API_KEY=replace-with-deepseek-key
DEEPSEEK__BASE_URL=https://api.deepseek.com
DEEPSEEK__MODEL=deepseek-v4-flash
DEEPSEEK__CONTEXT_WINDOW_TOKENS=65536
DEEPSEEK__MAX_OUTPUT_TOKENS=4096
DEEPSEEK__TOKEN_SAFETY_MARGIN=512
# 普通 RAG 回答优先使用非思考模式；证据筛选拥有独立开关。
DEEPSEEK__THINKING_ENABLED=false
OPENAI__API_KEY=replace-with-openai-key
OPENAI__BASE_URL=https://api.openai.com/v1
OPENAI__MODEL=gpt-5
OPENAI__CONTEXT_WINDOW_TOKENS=128000
OPENAI__MAX_OUTPUT_TOKENS=8192
OPENAI__TOKEN_SAFETY_MARGIN=1024

# 必须填写安全随机值；留空会让登录功能拒绝启动，HS256 密钥至少 32 字节。
AUTH__SECRET_KEY=
AUTH__ALGORITHM=HS256
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30
